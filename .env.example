# ============================================================
# 本檔是「本地開發」基準（dev_settings / SQLite，複製後不用改就能跑）。
# Docker 部署時要改的項目在 README「Docker 部署」章節有清單。
# ============================================================

# --- 本地開發 ---

# 本地用 dev_settings（SQLite）時下列變數都不需要；
# SECRET_KEY 有開發用預設值，生產環境務必換成隨機長字串
DEBUG=True
SECURE_SSL_REDIRECT=False

# Celery：本地沒有 Redis，背景任務改為同步執行
# Docker 部署時設為 false（compose 內有 Redis 容器）
CELERY_TASK_ALWAYS_EAGER=true

# --- Docker 部署必填：DB_PASSWORD 與 SECRET_KEY（其餘都有預設值） ---

# Database
DB_PASSWORD=
SECRET_KEY=change-me-to-a-random-string

# DB_* 都有預設值（compose 使用 DB_PASSWORD/DB_NAME，
# DB_USER/DB_HOST/DB_PORT 由 prod_settings 讀取），通常不用改
DB_NAME=exbook
DB_USER=root
DB_HOST=db
DB_PORT=3306

# Django（生產環境調整）
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-production-domain.com

# Gunicorn
GUNICORN_WORKERS=3

# Docker Compose
PORT=80

# Logging
# DJANGO_LOG_LEVEL=INFO       # Root and Django log level (DEBUG, INFO, WARNING, ERROR)
# SQL_LOG_LEVEL=DEBUG         # SQL query log level (DEBUG to see queries, higher to suppress)

# ============================================================
# 選填：Google OAuth 2.0（登入）
# 留空時登入頁的 Google 按鈕仍會顯示，點擊會失敗；
# email 註冊與登入不受影響。要啟用才需設定：
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 本地開發授權設定：
# - Authorized JavaScript origins: http://localhost:8000
# - Authorized redirect URIs: http://localhost:8000/accounts/google/login/callback/
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# 選填：AI — vLLM（OpenAI 相容端點），由 AI-Forge SDK (ai-client) 使用
# API_KEY / BASE_URL / MODEL 三者要同時設定；
# 有 key 但漏設其餘兩者時，AI 功能會 fallback 到 mock 並在 log 留下錯誤
# 完全未設定 VLLM_API_KEY 時，AI 功能也走 mock，程式照常運行
# 已知公開端點範例（國立臺北商業大學 BIRC）：
#   VLLM_API_KEY=your_key
#   VLLM_BASE_URL=https://chatapi.ntubimdbirc.tw/v1
#   VLLM_MODEL=Gemma4-31B
# ============================================================
# VLLM_API_KEY=
# VLLM_BASE_URL=
# VLLM_MODEL=

# ============================================================
# 選填：Email（SMTP 寄信）
# 預設 console backend：驗證信件顯示在 terminal，不設也能開發
# 需要真寄信（生產環境）時取消註解並填入
# ============================================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Exbooks <your-email@gmail.com>

# ============================================================
# 選填：Web Push 通知（VAPID）
# 產生方式：python manage.py generate_vapid_keys
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ============================================================
# 選填：MinIO S3 物件儲存（替代本機 filesystem 存 book 封面等媒體）
# USE_S3=false（預設）時全部忽略
# 啟動：docker compose up -d minio
# 第一次使用需建立 bucket：mc mb myminio/exbook-media
# 主機端開發可只用 localhost 測試:
#   MINIO_ENDPOINT=http://localhost:9000
#   MINIO_ROOT_USER=minioadmin
#   MINIO_ROOT_PASSWORD=minioadmin
# ============================================================
USE_S3=false
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password
