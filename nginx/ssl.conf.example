# Exbooks Nginx SSL 配置範本
#
# 使用方式：
#   1. 複製此檔覆蓋 default.conf：
#      cp nginx/ssl.conf.example nginx/default.conf
#
#   2. 修改 server_name 為你的正式網域
#
#   3. 執行 scripts/setup_ssl.sh 取得憑證
#
#   4. 重啟 Nginx：docker compose restart nginx
#
# 若使用 Cloudflare / Traefik 等外部 reverse proxy 處理 SSL，
# 則不需要此配置，保留原本的 nginx/default.conf 即可。

upstream django {
    server web:8000;
}

limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

# HTTP → HTTPS 強制轉址
server {
    listen 80;
    server_name your-domain.example.com;
    return 301 https://$server_name$request_uri;
}

# HTTPS
server {
    listen 443 ssl http2;
    server_name your-domain.example.com;
    client_max_body_size 10M;

    ssl_certificate     /etc/letsencrypt/live/your-domain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 靜態檔案
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 使用者上傳檔案
    location /media/ {
        alias /app/media/;
        expires 7d;
    }

    # 登入相關端點限速
    location ~* ^/accounts/(login|signup|password) {
        limit_req zone=login burst=3 nodelay;
        proxy_pass http://django;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # ACME 憑證驗證（certbot webroot mode）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 其餘請求轉發
    location / {
        proxy_pass http://django;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
